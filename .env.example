# ── Application ─────────────────────────────────────────────
APP_NAME="WhatsApp SaaS"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
APP_TIMEZONE=UTC

# ── Database (MySQL) ────────────────────────────────────────
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=whatsapp_saas
DB_USERNAME=whatsapp
DB_PASSWORD=secret

# ── Redis (cache / queues / Reverb / rate limiting) ─────────
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

QUEUE_CONNECTION=redis
CACHE_STORE=redis

# ── Auth ────────────────────────────────────────────────────
JWT_SECRET=

# ── Meta WhatsApp Cloud API ─────────────────────────────────
META_APP_ID=
META_APP_SECRET=
META_VERIFY_TOKEN=
META_API_VERSION=v23.0
META_CONFIG_ID=
# Production credential. Encrypted at rest per-WABA in DB; env is bootstrap only.
META_SYSTEM_USER_TOKEN=
# Set true in local/testing to use FakeWhatsAppProvider (no network calls).
META_USE_FAKE=true

# ── Encryption for stored Meta tokens ───────────────────────
# Uses APP_KEY by default; set a dedicated key if you rotate separately.
ENCRYPTION_KEY=

# ── AWS S3 (media) ──────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-south-1
AWS_BUCKET=

# ── Payments ────────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
RAZORPAY_KEY=
RAZORPAY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ── Reverb (WebSockets) ─────────────────────────────────────
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
